{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
                "Name": "Debug",
                "Args": {
                  "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u}] {Message:lj}{NewLine}{Exception}"
                }
            }
          ],
          "bufferSize": 10000,
          "blockWhenFull": false
        }
      },
            {
        "Name": "Async",
        "Args": {
          "configure": [
            {
                "Name": "File",
                "Args": {
                  "path": "logs/log-.txt",
                  "rollingInterval": "Day",
                  "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}]  [Thread:{ThreadId}] {Message:lj}{NewLine}{Exception}",
                  "retainedFileCountLimit": 30,
                  "shared": true
                }
            }
          ],
          "bufferSize": 10000,
          "blockWhenFull": false
        }
      }
    ]
  },
  
  "AppSettings": {
  }
}